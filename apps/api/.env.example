# Copy to .env and fill in. Never commit .env.
PORT=8000
CLIENT_URL=http://localhost:5173
# Only behind a hosting proxy or load balancer: how many proxy hops to trust (for example 1)
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=abe_garage
DB_USER=abe
DB_PASSWORD=change_me

JWT_SECRET=change_me_to_a_long_random_string
# How long a login lasts, in seconds (BE-004 asks for 1 hour)
JWT_EXPIRES_IN_SECONDS=3600
# Written into every login token and checked on every request
JWT_ISSUER=abe-garage-api
JWT_AUDIENCE=abe-garage-web

# First-time setup (POST /api/install). Send INSTALL_SECRET in the X-Setup-Key header.
# Use a long random value (16+ characters). Set INSTALL_ENABLED=false on a live server once setup is done.
INSTALL_ENABLED=true
INSTALL_SECRET=change_me_to_another_long_random_string

# The first admin, created once by POST /api/install
INSTALL_ADMIN_EMAIL=admin@abegarage.com
INSTALL_ADMIN_PASSWORD=change_me_8_chars_or_more
INSTALL_ADMIN_FIRST_NAME=Abe
INSTALL_ADMIN_LAST_NAME=Admin

# Garage time zone for "today" and "this week" (NFR-17)
APP_TIMEZONE=Africa/Addis_Ababa

# Garage SMTP account for status emails (leave SMTP_HOST empty to skip sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Abe Garage <no-reply@abegarage.com>"
