{
  "name": "abe-garage",
  "version": "0.1.0",
  "private": true,
  "description": "Abe Garage: car repair shop management (React + Express + MySQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "seed": "npm run seed --workspace backend --",
    "test": "npm test --workspace backend",
    "test:integration": "npm run test:integration --workspace backend"
  },
  "engines": {
    "node": ">=18"
  }
}
